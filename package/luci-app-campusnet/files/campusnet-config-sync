#!/bin/sh
# 把 LuCI 的 UCI 配置同步到 campusnet 的 config.json 和 cron

CONFIG_DIR="$HOME/.config/campusnet"
CONFIG_JSON="$CONFIG_DIR/config.json"
ENV_FILE="/etc/campusnet.env"
CRON_FILE="/etc/crontabs/root"

mkdir -p "$CONFIG_DIR"

ENABLED=$(uci -q get campusnet.config.enabled || echo "0")
USERNAME=$(uci -q get campusnet.config.username)
WIFI_SSID=$(uci -q get campusnet.config.wifi_ssid)
CARRIER=$(uci -q get campusnet.config.carrier)
INTERVAL=$(uci -q get campusnet.config.interval || echo "5")
TIMEOUT=$(uci -q get campusnet.config.timeout || echo "10")
PASSWORD=$(uci -q get campusnet.config.password)

{
    echo "{"
    echo "  \"username\": \"$USERNAME\","
    if [ -n "$WIFI_SSID" ]; then
        echo "  \"wifi_ssid\": \"$WIFI_SSID\","
    fi
    echo "  \"timeout\": ${TIMEOUT},"
    echo "  \"options\": {"
    if [ -n "$CARRIER" ]; then
        echo "    \"carrier\": \"$CARRIER\""
    else
        echo "    \"carrier\": \"auto\""
    fi
    echo "  }"
    echo "}"
} > "$CONFIG_JSON"
chmod 600 "$CONFIG_JSON"

if [ -n "$PASSWORD" ]; then
    cat > "$ENV_FILE" << ENVEOF
CAMPUSNET_PASSWORD='$PASSWORD'
ENVEOF
    chmod 600 "$ENV_FILE"
else
    rm -f "$ENV_FILE"
fi

sed -i '/campusnet once/d' "$CRON_FILE" 2>/dev/null

if [ "$ENABLED" = "1" ]; then
    if [ -f "$ENV_FILE" ]; then
        echo "*/${INTERVAL} * * * * . $ENV_FILE && /usr/bin/campusnet once 2>&1 | logger -t campusnet" >> "$CRON_FILE"
    else
        echo "*/${INTERVAL} * * * * /usr/bin/campusnet once 2>&1 | logger -t campusnet" >> "$CRON_FILE"
    fi
    /etc/init.d/cron restart
fi

exit 0
