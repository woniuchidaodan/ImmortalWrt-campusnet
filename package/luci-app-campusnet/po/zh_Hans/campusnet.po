msgid "校园网自动登录"
msgstr "校园网自动登录"

msgid "配置校园网自动登录参数。认证系统会自动识别，无需手动指定。"
msgstr "配置校园网自动登录参数。认证系统会自动识别，无需手动指定。"

msgid "基本设置"
msgstr "基本设置"

msgid "启用"
msgstr "启用"

msgid "开启后，campusnet 将通过 cron 定时检查并自动登录。"
msgstr "开启后，campusnet 将通过 cron 定时检查并自动登录。"

msgid "学号 / 上网账号"
msgstr "学号 / 上网账号"

msgid "你的校园网登录账号。"
msgstr "你的校园网登录账号。"

msgid "密码"
msgstr "密码"

msgid "校园网登录密码。保存在 /etc/campusnet.env（权限 0600）。"
msgstr "校园网登录密码。保存在 /etc/campusnet.env（权限 0600）。"

msgid "校园 Wi-Fi 名称（SSID）"
msgstr "校园 Wi-Fi 名称（SSID）"

msgid "填入校园网的 Wi-Fi 名称，换网后可自动切回。"
msgstr "填入校园网的 Wi-Fi 名称，换网后可自动切回。"

msgid "运营商"
msgstr "运营商"

msgid "默认“自动识别”即可，campusnet 会探测门户页面判断。"
msgstr "默认“自动识别”即可，campusnet 会探测门户页面判断。"

msgid "自动识别"
msgstr "自动识别"

msgid "校园用户"
msgstr "校园用户"

msgid "中国移动"
msgstr "中国移动"

msgid "中国电信"
msgstr "中国电信"

msgid "中国联通"
msgstr "中国联通"

msgid "电信校园网"
msgstr "电信校园网"

msgid "联通校园网"
msgstr "联通校园网"

msgid "校园其他"
msgstr "校园其他"

msgid "检查间隔（分钟）"
msgstr "检查间隔（分钟）"

msgid "cron 定时任务的执行间隔，默认 5 分钟。"
msgstr "cron 定时任务的执行间隔，默认 5 分钟。"

msgid "请求超时（秒）"
msgstr "请求超时（秒）"

msgid "单次认证请求的超时时间，默认 10 秒。"
msgstr "单次认证请求的超时时间，默认 10 秒。"

msgid "运行日志"
msgstr "运行日志"

msgid "校园网自动登录 - 运行日志"
msgstr "校园网自动登录 - 运行日志"

msgid "下方显示 campusnet 最近的运行日志（来自 syslog）。"
msgstr "下方显示 campusnet 最近的运行日志（来自 syslog）。"

